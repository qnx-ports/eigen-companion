# Alpine-Contributor: Bradley J Chambers <brad.chambers@gmail.com>
# Alpine-Maintainer: Bradley J Chambers <brad.chambers@gmail.com>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=eigen
pkgver=5.0.1
pkgrel=0
pkgdesc="Eigen is a C++ template library for linear algebra"
url="https://eigen.tuxfamily.org/"
arch="all"
license="MPL-2.0"
options="!check"  # checks take a long time, and tend to fail randomly
depends="libc++"
makedepends="
    cmake
    fftw-dev
    ninja
    clang
    flang
    libc++-dev
    "
subpackages="$pkgname-dev"
source="https://gitlab.com/libeigen/eigen/-/archive/$pkgver/eigen-$pkgver.tar.gz
    "

build() {
    CC=clang \
    CXX=clang++ \
    FC=flang \
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_DATADIR=/usr/lib
    cmake --build build
}

check() {
    ctest --test-dir build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

dev() {
    default_dev
    amove usr/lib/eigen3
}

sha512sums="
b337d3bc38440db190a8f1fbc4eabc0098e69fcc95bfba195fe039ffb942cae2a7f0153f3094f35fa26325750d1c62e20cccaf916a41f5c7f248ec5e5d30a942  eigen-5.0.1.tar.gz
"
